# Set once on the server. Viewers never enter keys.
# Use an approved, centrally funded provider. Never commit real secrets.
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
# JEV_PROVIDER=vercel
# AI_GATEWAY_API_KEY=
PORT=4318

# Internal hosting: all are required in shared mode.
# BUFO_MODE=shared
# BUFO_PUBLIC_ORIGIN=https://bufo.your-internal-domain.example
# BUFO_PROXY_SECRET=
# BUFO_GITHUB_TOKEN=
# BUFO_DATA_DIR=/data

# Public Fly hosting: no sign-in or hosted GitHub credential.
# BUFO_MODE=public
# BUFO_PUBLIC_ORIGIN=https://your-app.fly.dev
# BUFO_DATA_DIR=/data
# BUFO_CATALOG_DIR=/app/public-assets
# BUFO_DAILY_TOKEN_LIMIT=25000000
